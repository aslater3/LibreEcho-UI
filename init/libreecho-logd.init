#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-logd
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: LibreEcho central log daemon
# Description:       Aggregates logs from all LibreEcho services
### END INIT INFO

DAEMON=/usr/local/sbin/libreecho-logd
PIDFILE=/var/run/libreecho-logd.pid
LOGDIR=/var/log/libreecho

do_start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "libreecho-logd already running"
        return 0
    fi
    
    mkdir -p "$LOGDIR" "$(dirname "$PIDFILE")"
    
    echo "Starting libreecho-logd"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
            --exec "$DAEMON" -- --foreground || return 1
    else
        "$DAEMON" --foreground </dev/null >>"$LOGDIR/logd.log" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

do_stop() {
    if [ ! -f "$PIDFILE" ] || ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "libreecho-logd not running"
        return 0
    fi
    
    echo "Stopping libreecho-logd"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon --stop --pidfile "$PIDFILE" --retry 5 || return 1
    else
        pid=$(cat "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

do_status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "libreecho-logd running (PID $(cat "$PIDFILE"))"
        return 0
    else
        echo "libreecho-logd not running"
        return 3
    fi
}

case "$1" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart|reload)
        do_stop
        do_start
        ;;
    status)
        do_status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
