#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-watchdogd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-watchdogd ] && . /etc/default/libreecho-watchdogd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-watchdogd}
PIDFILE=${PIDFILE:-/var/run/libreecho-watchdogd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-watchdogd.log}

# The supervised services are still starting when this one does, and a service
# that has not finished starting is not a service that has failed. The delay is
# handled inside the daemon rather than with a sleep here, so starting the
# watchdog never holds up the rest of the boot.
START_DELAY=${START_DELAY:-60}
INTERVAL=${INTERVAL:-5}

ARGS=${ARGS:---foreground --interval $INTERVAL --start-delay $START_DELAY}

running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}
pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}
# Every process whose parent is $1. Recovery runs another service's init script
# as a child of this daemon, and a service start can wait a long time -- agentd
# waits up to 90s for its dependency sockets -- before it launches anything or
# touches /data/libreecho. Stopping the supervisor therefore has to stop the
# recovery it already launched: a recovery that is still in flight when the
# daemon dies keeps running, and the caller that asked for the stop has no way
# to see it. A dead daemon's children are reparented, so they are collected
# while the parent is still alive.
children_of() {
    parent=$1
    [ -n "$parent" ] || return 0
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ "$candidate" = "$parent" ] && continue
        [ -r "$entry/status" ] || continue
        ppid=$(sed -n 's/^PPid:[^0-9]*//p' "$entry/status" 2>/dev/null | sed -n '1p')
        [ "$ppid" = "$parent" ] && printf '%s\n' "$candidate"
    done
}
is_running() { pidfile_pid >/dev/null && return 0; [ -n "$(running_pids)" ]; }
terminate() {
    target=$1; limit=${2:-5}; kill "$target" 2>/dev/null || true; count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do sleep 1; count=$((count + 1)); done
    kill -KILL "$target" 2>/dev/null || true
}
start_service() {
    if is_running; then echo "${DAEMON##*/} already running"; return 0; fi
    [ -x "$DAEMON" ] || { echo "${DAEMON##*/}: not on this image"; return 0; }
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        if command -v setsid >/dev/null 2>&1; then setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 & fi
        launched=$!; echo "$launched" >"$PIDFILE"; started=; count=0
        while [ "$count" -lt 20 ]; do started=$(running_pids | sort -n | sed -n '1p'); [ -n "$started" ] && break; sleep 0.05; count=$((count + 1)); done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}
stop_service() {
    # Collect the supervisor process and the recovery it has in flight before
    # terminating anything: once the daemon is gone its children are reparented
    # and can no longer be found by parent.
    recovery=
    for owner in $(pidfile_pid 2>/dev/null || true) $(running_pids); do
        for child in $(children_of "$owner"); do recovery="$recovery $child"; done
    done
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else pid=$(pidfile_pid) && terminate "$pid" 5; fi
    for stray in $(running_pids); do
        for child in $(children_of "$stray"); do recovery="$recovery $child"; done
        terminate "$stray" 5
    done
    # A recovery is a shell waiting on another service's init script, so a
    # two-second grace is enough and keeps the caller's stop bounded.
    for child in $recovery; do terminate "$child" 2; done
    rm -f "$PIDFILE"
}

case "$1" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) is_running && echo "running" || { echo "stopped"; exit 3; } ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
exit 0
