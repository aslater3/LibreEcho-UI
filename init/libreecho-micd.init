#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-micd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-micd ] && . /etc/default/libreecho-micd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-micd}
PIDFILE=${PIDFILE:-/var/run/libreecho-micd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-micd.log}
SOCKET=${SOCKET:-/run/libreecho/mic.sock}
ARGS=${ARGS:---foreground --socket $SOCKET}

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
# The TLV320AIC3101 comes up with its analog capture PGA at 0, and nothing in
# the image ever raises it -- the UI's microphone_gain is only ever reported,
# never applied to the codec. The result is a device that is effectively deaf:
# the wake word fires only when someone is close and loud, and end-of-speech
# detection has almost no signal to work with. Measured on hardware: with the
# PGA at 0 "Alexa" produced no detection at all; at 60 it scored 0.9998.
#
# Apply the configured gain to the codec before micd opens the device, and
# never let it reach 0. Silencing the microphone is what microphone_muted is
# for; a zero preamp just makes the device look broken.
MIC_PGA_MIN=${MIC_PGA_MIN:-24}
MIC_PGA_MAX=${MIC_PGA_MAX:-95}

apply_capture_gain() {
    command -v tinymix >/dev/null 2>&1 || return 0
    gain=
    if [ -r "$CONFIG" ]; then
        gain=$(sed -n 's/.*"microphone_gain"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            "$CONFIG" | sed -n '1p')
    fi
    case "$gain" in ''|*[!0-9]*) gain=50 ;; esac
    [ "$gain" -gt 100 ] && gain=100
    pga=$(( gain * MIC_PGA_MAX / 100 ))
    [ "$pga" -lt "$MIC_PGA_MIN" ] && pga=$MIC_PGA_MIN
    if tinymix -D 0 set "PGA Level Volume" "$pga" "$pga" >/dev/null 2>&1; then
        echo "libreecho-micd: capture PGA set to $pga (gain $gain)" >&2
    else
        echo "libreecho-micd: could not set capture PGA" >&2
    fi
}

start_service() {
    if is_running; then echo "libreecho-micd already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    apply_capture_gain
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
