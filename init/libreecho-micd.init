#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-micd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-micd ] && . /etc/default/libreecho-micd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-micd}
PIDFILE=${PIDFILE:-/var/run/libreecho-micd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-micd.log}
SOCKET=${SOCKET:-/run/libreecho/mic.sock}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
CAPTURE_MUX=${CAPTURE_MUX:-/usr/local/sbin/libreecho-capture-mux}
CAPTURE_BIN=${CAPTURE_BIN:-/sbin/tinycap}
MIC_INJECT_DIR=${MIC_INJECT_DIR:-/run/libreecho/mic-inject}
ARGS=${ARGS:---foreground --socket $SOCKET}

# The mux forwards the codec unchanged, and substitutes rendered audio for it
# on request without ever ending the stream. That last part is not a nicety:
# waked connects to micd's mono stream once, has no reconnect path, and its
# init has no supervisor, so anything that ends the stream costs the device its
# wake word until something restarts waked by hand.
#
# Fall back to the codec if the mux is missing. A capture path that does not
# start is far worse than losing the ability to inject test audio, so the mux
# is only used when it is actually present and executable.
select_capture_path() {
    if [ -x "$CAPTURE_MUX" ]; then
        mkdir -p "$MIC_INJECT_DIR"
        LE_CAPTURE_MUX_BIN=$CAPTURE_BIN
        LE_CAPTURE_MUX_CONTROL_DIR=$MIC_INJECT_DIR
        export LE_CAPTURE_MUX_BIN LE_CAPTURE_MUX_CONTROL_DIR
        printf '%s\n' "$CAPTURE_MUX"
    else
        printf '%s\n' "$CAPTURE_BIN"
    fi
}

config_number() {
    key=$1
    fallback=$2
    value=
    if [ -r "$CONFIG" ]; then
        value=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" \
            "$CONFIG" | sed -n '1p')
    fi
    case "$value" in ''|*[!0-9]*) value=$fallback ;; esac
    printf '%s\n' "$value"
}

# configure_capture_path() runs on every capture start, so the MICPGA level it
# writes is the one that sticks; the owner's gain has to reach micd or it is
# overwritten as soon as the wake listener reopens the stream.
export_capture_gain() {
    LE_MIC_CAPTURE_GAIN=$(config_number microphone_gain "")
    [ -n "$LE_MIC_CAPTURE_GAIN" ] && export LE_MIC_CAPTURE_GAIN
    return 0
}

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

start_service() {
    if is_running; then echo "libreecho-micd already running"; return 0; fi
    export_capture_gain
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    ARGS="$ARGS --capture-bin $(select_capture_path)"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 5
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 5
    done
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
