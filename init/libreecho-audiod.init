#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-audiod
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-audiod ] && . /etc/default/libreecho-audiod

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-audiod}
PIDFILE=${PIDFILE:-/var/run/libreecho-audiod.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-audiod.log}
SOCKET=${SOCKET:-/run/libreecho/audio.sock}
CONFIG=${CONFIG:-/data/libreecho/config/web-config.json}
ARGS=${ARGS:---foreground --socket $SOCKET}

config_number() {
    key=$1
    fallback=$2
    value=
    if [ -r "$CONFIG" ]; then
        value=$(sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" \
            "$CONFIG" | sed -n '1p')
    fi
    case "$value" in ''|*[!0-9]*) value=$fallback ;; esac
    printf '%s\n' "$value"
}

# The codec powers up at its own default, and audiod only ever read the mixer,
# so a gain set through the API survived in web-config.json while the hardware
# quietly reverted on every boot.  The configured VAD floor is chosen for a
# particular capture gain, so a silent revert also broke voice: the floor no
# longer matched the signal.  Hand the persisted levels to the daemon so it can
# put the hardware back where the owner left it.
# micd rewrites the whole capture path -- Mic PGA, ADC input selects, MICPGA
# volumes -- straight through the mixer, and that wipes any level restored
# before it runs.  Both daemons are launched with start-stop-daemon -b, so
# ordering them in the service list only orders the launches, not the work:
# audiod finished first and its restore was overwritten a moment later.
#
# micd creates its socket after the mixer profile is applied, so the socket
# appearing is the signal that the capture path has settled.  Wait for it,
# with a bounded timeout so a device without micd still brings audio up.
MIC_SOCKET=${MIC_SOCKET:-/run/libreecho/mic.sock}
CAPTURE_WAIT_SECONDS=${CAPTURE_WAIT_SECONDS:-8}

wait_for_capture_path() {
    waited=0
    while [ ! -S "$MIC_SOCKET" ] && [ "$waited" -lt "$CAPTURE_WAIT_SECONDS" ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [ -S "$MIC_SOCKET" ]; then
        # The socket appears immediately after the profile is written; give the
        # mixer writes a moment to land before setting levels on top of them.
        sleep 1
    fi
    return 0
}

apply_persisted_levels() {
    LE_AUDIO_MIC_GAIN=$(config_number microphone_gain "")
    LE_AUDIO_VOLUME=$(config_number volume "")
    [ -n "$LE_AUDIO_MIC_GAIN" ] && export LE_AUDIO_MIC_GAIN
    [ -n "$LE_AUDIO_VOLUME" ] && export LE_AUDIO_VOLUME
    return 0
}

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    if is_running; then echo "libreecho-audiod already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    wait_for_capture_path
    apply_persisted_levels
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
