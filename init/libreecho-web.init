#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-web
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-web ] && . /etc/default/libreecho-web

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-web}
PIDFILE=${PIDFILE:-/var/run/libreecho-web.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-web.log}
CONFIG_FILE=${CONFIG_FILE:-/data/libreecho/config/web-config.json}
DEFAULT_CONFIG_FILE=${DEFAULT_CONFIG_FILE:-/etc/libreecho/web-config.json}
mkdir -p "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ] && [ -r "$DEFAULT_CONFIG_FILE" ]; then
    cp "$DEFAULT_CONFIG_FILE" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
fi
# This development image deliberately exposes the UI through wlan0.  Production
# deployments must override ARGS with authentication and an allowed origin.
ARGS=${ARGS:---backend linux --config $CONFIG_FILE --web-root /usr/local/share/libreecho/web --listen 0.0.0.0:8080 --allow-insecure-lan}
# For authenticated LAN access, override ARGS in /etc/default/libreecho-web
# with --auth-token-file, --allowed-origin and --user.
USERS_FILE=${USERS_FILE:-/data/libreecho/config/users}
if [ -r "$USERS_FILE" ]; then
    ARGS="$ARGS --users-file $USERS_FILE"
fi

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    if is_running; then echo "libreecho-web already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
