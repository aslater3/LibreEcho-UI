#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-web
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-web ] && . /etc/default/libreecho-web

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-web}
PIDFILE=${PIDFILE:-/var/run/libreecho-web.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-web.log}
CONFIG_FILE=${CONFIG_FILE:-/data/libreecho/config/web-config.json}
DEFAULT_CONFIG_FILE=${DEFAULT_CONFIG_FILE:-/etc/libreecho/web-config.json}
mkdir -p "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ] && [ -r "$DEFAULT_CONFIG_FILE" ]; then
    cp "$DEFAULT_CONFIG_FILE" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
fi
# This development image deliberately exposes the UI through wlan0.  Production
# deployments must override ARGS with authentication and an allowed origin.
ARGS=${ARGS:---backend linux --config $CONFIG_FILE --web-root /usr/local/share/libreecho/web --listen 0.0.0.0:8080 --allow-insecure-lan}
# For authenticated LAN access, override ARGS in /etc/default/libreecho-web
# with --auth-token-file, --allowed-origin and --user.
USERS_FILE=${USERS_FILE:-/data/libreecho/config/users}
ARGS="$ARGS --users-file $USERS_FILE"
STARTUP_READY=${STARTUP_READY:-/run/libreecho/startup-ready}
STARTUP_READY_TIMEOUT_TICKS=${STARTUP_READY_TIMEOUT_TICKS:-600}
PORT=10700
[ -r /etc/default/libreecho-wyomingd ] && . /etc/default/libreecho-wyomingd

# Every pid whose argv[0] is exactly $DAEMON. A pidfile is not proof of life:
# it goes stale when the daemon is started from a shell that then exits (the
# fallback branch of start_service() leaves the child in the caller's process
# group), and it goes missing when /run is cleared. Matching on the executable
# means stop and status still see the daemon in both cases, so restart cannot
# silently leave a second copy running.
running_pids() {
    for entry in /proc/[0-9]*; do
        candidate=${entry#/proc/}
        [ "$candidate" = "$$" ] && continue
        [ -r "$entry/cmdline" ] || continue
        argv0=$(tr '\0' '\n' < "$entry/cmdline" 2>/dev/null | sed -n '1p')
        [ "$argv0" = "$DAEMON" ] && printf '%s\n' "$candidate"
    done
}

pidfile_pid() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_running() {
    pidfile_pid >/dev/null && return 0
    [ -n "$(running_pids)" ]
}

# Sends TERM, waits up to $2 seconds (default 5), then KILL.
terminate() {
    target=$1
    limit=${2:-5}
    kill "$target" 2>/dev/null || true
    count=0
    while kill -0 "$target" 2>/dev/null && [ "$count" -lt "$limit" ]; do
        sleep 1
        count=$((count + 1))
    done
    kill -KILL "$target" 2>/dev/null || true
}

startup_services_ready() {
    service=
    for service in networkd timed audiod micd ledd btd airplayd web; do
        pidfile="/var/run/libreecho-$service.pid"
        [ -s "$pidfile" ] || return 1
        pid=$(sed -n '1p' "$pidfile")
        case "$pid" in *[!0-9]*|'') return 1 ;; esac
        kill -0 "$pid" 2>/dev/null || return 1
    done
    for socket in network audio mic led bluetooth airplay; do
        [ -S "/run/libreecho/$socket.sock" ] || return 1
    done
    [ -f /run/libreecho/bluetooth-ready ] || return 1
    if [ -S /run/libreecho/stt.sock ] &&
       [ -S /run/libreecho/tts.sock ] &&
       [ -S /run/libreecho/agent.sock ]; then
        for service in sttd ttsd agentd; do
            pidfile="/var/run/libreecho-$service.pid"
            [ -s "$pidfile" ] || return 1
            pid=$(sed -n '1p' "$pidfile")
            case "$pid" in *[!0-9]*|'') return 1 ;; esac
            kill -0 "$pid" 2>/dev/null || return 1
        done
        return 0
    fi
    wyoming_service_ready
}

wyoming_service_ready() {
    pidfile=/var/run/libreecho-wyomingd.pid
    [ -s "$pidfile" ] || return 1
    pid=$(sed -n '1p' "$pidfile")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -S /run/libreecho/wakeword.sock ] || return 1
    wake_pidfile=/var/run/libreecho-waked.pid
    [ -s "$wake_pidfile" ] || return 1
    wake_pid=$(sed -n '1p' "$wake_pidfile")
    case "$wake_pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$wake_pid" 2>/dev/null || return 1
    port_hex=$(printf '%04X' "$PORT") || return 1
    awk -v port="$port_hex" \
        '$4 == "0A" && $2 ~ (":" port "$") { found = 1 }
         END { exit found ? 0 : 1 }' /proc/net/tcp 2>/dev/null
}

mark_startup_ready() {
    count=0
    while :; do
        if startup_services_ready; then
            tmp="$STARTUP_READY.tmp"
            printf 'schema=1\n' >"$tmp" || return 1
            mv -f "$tmp" "$STARTUP_READY"
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
        [ "$count" -lt "$STARTUP_READY_TIMEOUT_TICKS" ] || count=0
    done
}

start_service() {
    if is_running; then echo "libreecho-web already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        # setsid detaches the child from this shell's process group. Without it
        # the daemon dies with the shell that started it -- which is why a
        # restart issued over adb or ssh appeared to work and then evaporated.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        else
            "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        fi
        launched=$!
        echo "$launched" >"$PIDFILE"
        # setsid normally execs the daemon in-place, so the common case resolves
        # immediately. If it forks, poll briefly for the real daemon instead of
        # delaying every service start by a fixed second.
        started=
        count=0
        while [ "$count" -lt 20 ]; do
            if [ -r "/proc/$launched/cmdline" ]; then
                argv0=$(tr '\0' '\n' < "/proc/$launched/cmdline" 2>/dev/null | sed -n '1p')
                if [ "$argv0" = "$DAEMON" ]; then
                    started=$launched
                    break
                fi
            fi
            started=$(running_pids | sort -n | sed -n '1p')
            [ -n "$started" ] && break
            sleep 0.05
            count=$((count + 1))
        done
        [ -n "$started" ] && echo "$started" >"$PIDFILE"
    fi
}

stop_service() {
    if pidfile_pid >/dev/null && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(pidfile_pid) && terminate "$pid" 5
    fi
    # Sweep anything the pidfile did not account for. Without this a lost or
    # stale pidfile made stop a no-op that still reported success, and the
    # following start added a second daemon instead of replacing the first.
    for stray in $(running_pids); do
        terminate "$stray" 5
    done
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start)
        rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"
        start_service
        mark_startup_ready >/dev/null 2>&1 &
        ;;
    stop) stop_service ;;
    restart) stop_service; rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"; start_service; mark_startup_ready >/dev/null 2>&1 & ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
