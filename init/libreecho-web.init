#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-web
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-web ] && . /etc/default/libreecho-web

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-web}
PIDFILE=${PIDFILE:-/var/run/libreecho-web.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-web.log}
CONFIG_FILE=${CONFIG_FILE:-/data/libreecho/config/web-config.json}
DEFAULT_CONFIG_FILE=${DEFAULT_CONFIG_FILE:-/etc/libreecho/web-config.json}
mkdir -p "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ] && [ -r "$DEFAULT_CONFIG_FILE" ]; then
    cp "$DEFAULT_CONFIG_FILE" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
fi
# This development image deliberately exposes the UI through wlan0.  Production
# deployments must override ARGS with authentication and an allowed origin.
ARGS=${ARGS:---backend linux --config $CONFIG_FILE --web-root /usr/local/share/libreecho/web --listen 0.0.0.0:8080 --allow-insecure-lan}
# For authenticated LAN access, override ARGS in /etc/default/libreecho-web
# with --auth-token-file, --allowed-origin and --user.
USERS_FILE=${USERS_FILE:-/data/libreecho/config/users}
ARGS="$ARGS --users-file $USERS_FILE"
STARTUP_READY=${STARTUP_READY:-/run/libreecho/startup-ready}
STARTUP_READY_TIMEOUT_TICKS=${STARTUP_READY_TIMEOUT_TICKS:-600}
BT_READY_PATH=${BT_READY_PATH:-/run/libreecho/bluetooth-ready}
PORT=10700
[ -r /etc/default/libreecho-wyomingd ] && . /etc/default/libreecho-wyomingd

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

bluetooth_integration_state() {
    integrations=
    if [ -r "$CONFIG_FILE" ]; then
        integrations=$(sed -n \
            's/.*"integrations"[[:space:]]*:[[:space:]]*\([^,}]*\).*$/\1/p' \
            "$CONFIG_FILE" 2>/dev/null | sed -n '1p' | tr -d '[:space:]')
    fi
    if [ -z "$integrations" ]; then
        printf '%s\n' disabled
        return 0
    fi
    case "$integrations" in
        *[!0-9]*)
            printf '%s\n' unknown
            return 0
            ;;
    esac
    if [ $((integrations & 8)) -ne 0 ]; then
        printf '%s\n' enabled
    else
        printf '%s\n' disabled
    fi
}

bluetooth_ready() {
    case "$(bluetooth_integration_state)" in
        disabled) return 0 ;;
        enabled) [ -f "$BT_READY_PATH" ] ;;
        *)
            echo "libreecho-web: Bluetooth integration state is invalid" >&2
            return 1
            ;;
    esac
}

startup_services_ready() {
    service=
    for service in networkd timed audiod micd ledd airplayd web; do
        pidfile="/var/run/libreecho-$service.pid"
        [ -s "$pidfile" ] || return 1
        pid=$(sed -n '1p' "$pidfile")
        case "$pid" in *[!0-9]*|'') return 1 ;; esac
        kill -0 "$pid" 2>/dev/null || return 1
    done
    for socket in network audio mic led airplay; do
        [ -S "/run/libreecho/$socket.sock" ] || return 1
    done
    case "$(bluetooth_integration_state)" in
        disabled) ;;
        enabled)
            [ -s /var/run/libreecho-btd.pid ] || return 1
            pid=$(sed -n '1p' /var/run/libreecho-btd.pid)
            case "$pid" in *[!0-9]*|'') return 1 ;; esac
            kill -0 "$pid" 2>/dev/null || return 1
            [ -S /run/libreecho/bluetooth.sock ] || return 1
            bluetooth_ready || return 1
            ;;
        *) return 1 ;;
    esac
    if [ -S /run/libreecho/stt.sock ] &&
       [ -S /run/libreecho/tts.sock ] &&
       [ -S /run/libreecho/agent.sock ]; then
        for service in sttd ttsd agentd; do
            pidfile="/var/run/libreecho-$service.pid"
            [ -s "$pidfile" ] || return 1
            pid=$(sed -n '1p' "$pidfile")
            case "$pid" in *[!0-9]*|'') return 1 ;; esac
            kill -0 "$pid" 2>/dev/null || return 1
        done
        return 0
    fi
    wyoming_service_ready
}

wyoming_service_ready() {
    pidfile=/var/run/libreecho-wyomingd.pid
    [ -s "$pidfile" ] || return 1
    pid=$(sed -n '1p' "$pidfile")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -S /run/libreecho/wakeword.sock ] || return 1
    wake_pidfile=/var/run/libreecho-waked.pid
    [ -s "$wake_pidfile" ] || return 1
    wake_pid=$(sed -n '1p' "$wake_pidfile")
    case "$wake_pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$wake_pid" 2>/dev/null || return 1
    port_hex=$(printf '%04X' "$PORT") || return 1
    awk -v port="$port_hex" \
        '$4 == "0A" && $2 ~ (":" port "$") { found = 1 }
         END { exit found ? 0 : 1 }' /proc/net/tcp 2>/dev/null
}

mark_startup_ready() {
    count=0
    while :; do
        if startup_services_ready; then
            tmp="$STARTUP_READY.tmp"
            printf 'schema=1\n' >"$tmp" || return 1
            mv -f "$tmp" "$STARTUP_READY"
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
        [ "$count" -lt "$STARTUP_READY_TIMEOUT_TICKS" ] || count=0
    done
}

start_service() {
    if is_running; then echo "libreecho-web already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start)
        rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"
        start_service
        mark_startup_ready >/dev/null 2>&1 &
        ;;
    stop) stop_service ;;
    restart) stop_service; rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"; start_service; mark_startup_ready >/dev/null 2>&1 & ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
