#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-web
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-web ] && . /etc/default/libreecho-web

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-web}
PIDFILE=${PIDFILE:-/var/run/libreecho-web.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-web.log}
CONFIG_FILE=${CONFIG_FILE:-/data/libreecho/config/web-config.json}
DEFAULT_CONFIG_FILE=${DEFAULT_CONFIG_FILE:-/etc/libreecho/web-config.json}
mkdir -p "$(dirname "$CONFIG_FILE")"
if [ ! -f "$CONFIG_FILE" ] && [ -r "$DEFAULT_CONFIG_FILE" ]; then
    cp "$DEFAULT_CONFIG_FILE" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
fi
# This development image deliberately exposes the UI through wlan0.  Production
# deployments must override ARGS with authentication and an allowed origin.
ARGS=${ARGS:---backend linux --config $CONFIG_FILE --web-root /usr/local/share/libreecho/web --listen 0.0.0.0:8080 --allow-insecure-lan}
# For authenticated LAN access, override ARGS in /etc/default/libreecho-web
# with --auth-token-file, --allowed-origin and --user.
USERS_FILE=${USERS_FILE:-/data/libreecho/config/users}
ARGS="$ARGS --users-file $USERS_FILE"
STARTUP_READY=${STARTUP_READY:-/run/libreecho/startup-ready}
STARTUP_READY_TIMEOUT_TICKS=${STARTUP_READY_TIMEOUT_TICKS:-600}
STARTUP_READY_PIDFILE=${STARTUP_READY_PIDFILE:-/run/libreecho/web-startup-ready.pid}
WYOMING_PIDFILE=${WYOMING_PIDFILE:-/var/run/libreecho-wyomingd.pid}
WYOMING_WAKE_SOCKET=${WYOMING_WAKE_SOCKET:-/run/libreecho/wakeword.sock}
WYOMING_WAKE_PIDFILE=${WYOMING_WAKE_PIDFILE:-/var/run/libreecho-waked.pid}
WYOMING_PORT=${WYOMING_PORT:-10700}
if [ -r /etc/default/libreecho-wyomingd ]; then
    # Match the Wyoming init's shell semantics without importing its DAEMON,
    # PIDFILE, LOGFILE or ARGS variables into this service.
    configured_port=$(sh -c '
        . /etc/default/libreecho-wyomingd || exit 1
        set -- ${ARGS:-}
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --port) shift; printf "%s" "${1:-}"; exit 0 ;;
                --port=*) printf "%s" "${1#--port=}"; exit 0 ;;
            esac
            shift
        done
        printf "%s" "${PORT:-}"
    ' 2>/dev/null)
    case "$configured_port" in ''|*[!0-9]*) ;; *) WYOMING_PORT=$configured_port ;; esac
fi
WYOMING_PORT=$(printf '%s' "$WYOMING_PORT" | sed 's/^0*//; s/^$/0/')

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

startup_services_ready() {
    service=
    for service in networkd timed audiod micd ledd btd airplayd web; do
        pidfile="/var/run/libreecho-$service.pid"
        [ -s "$pidfile" ] || return 1
        pid=$(sed -n '1p' "$pidfile")
        case "$pid" in *[!0-9]*|'') return 1 ;; esac
        kill -0 "$pid" 2>/dev/null || return 1
    done
    for socket in network audio mic led bluetooth airplay; do
        [ -S "/run/libreecho/$socket.sock" ] || return 1
    done
    if [ -S /run/libreecho/stt.sock ] &&
       [ -S /run/libreecho/tts.sock ] &&
       [ -S /run/libreecho/agent.sock ]; then
        for service in sttd ttsd agentd; do
            pidfile="/var/run/libreecho-$service.pid"
            [ -s "$pidfile" ] || return 1
            pid=$(sed -n '1p' "$pidfile")
            case "$pid" in *[!0-9]*|'') return 1 ;; esac
            kill -0 "$pid" 2>/dev/null || return 1
        done
        return 0
    fi
    wyoming_service_ready
}

wyoming_service_ready() {
    pidfile=$WYOMING_PIDFILE
    [ -s "$pidfile" ] || return 1
    pid=$(sed -n '1p' "$pidfile")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -S "$WYOMING_WAKE_SOCKET" ] || return 1
    wake_pidfile=$WYOMING_WAKE_PIDFILE
    [ -s "$wake_pidfile" ] || return 1
    wake_pid=$(sed -n '1p' "$wake_pidfile")
    case "$wake_pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$wake_pid" 2>/dev/null || return 1
    case "$WYOMING_PORT" in ''|*[!0-9]*|0) return 1 ;; esac
    [ "$WYOMING_PORT" -le 65535 ] || return 1
    port_hex=$(printf '%04X' "$WYOMING_PORT") || return 1
    awk -v port="$port_hex" \
        '$4 == "0A" && $2 ~ (":" port "$") { found = 1 }
         END { exit found ? 0 : 1 }' /proc/net/tcp 2>/dev/null
}

stop_startup_ready_poller() {
    [ -s "$STARTUP_READY_PIDFILE" ] || return 0
    pid=$(sed -n '1p' "$STARTUP_READY_PIDFILE")
    case "$pid" in *[!0-9]*|'') rm -f "$STARTUP_READY_PIDFILE"; return 0 ;; esac
    if [ -r "/proc/$pid/cmdline" ] &&
       tr '\000' ' ' <"/proc/$pid/cmdline" | grep -Fq "$0"; then
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$STARTUP_READY_PIDFILE"
}

start_startup_ready_poller() {
    mkdir -p "$(dirname "$STARTUP_READY_PIDFILE")" || return 1
    (
        while [ ! -s "$STARTUP_READY_PIDFILE" ]; do sleep 0.01; done
        mark_startup_ready "$(sed -n '1p' "$STARTUP_READY_PIDFILE")"
    ) >/dev/null 2>&1 &
    printf '%s\n' "$!" >"$STARTUP_READY_PIDFILE"
}

mark_startup_ready() {
    expected_poller_pid=$1
    count=0
    while :; do
        if startup_services_ready; then
            tmp="$STARTUP_READY.tmp"
            printf 'schema=1\n' >"$tmp" || return 1
            mv -f "$tmp" "$STARTUP_READY"
            [ "$(sed -n '1p' "$STARTUP_READY_PIDFILE" 2>/dev/null)" = "$expected_poller_pid" ] && rm -f "$STARTUP_READY_PIDFILE"
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
        [ "$count" -lt "$STARTUP_READY_TIMEOUT_TICKS" ] || count=0
    done
}

start_service() {
    if is_running; then echo "libreecho-web already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    stop_startup_ready_poller
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start)
        stop_startup_ready_poller
        rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"
        start_service
        start_startup_ready_poller
        ;;
    stop) stop_service ;;
    restart)
        stop_service
        rm -f "$STARTUP_READY" "$STARTUP_READY.tmp"
        start_service
        start_startup_ready_poller
        ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
