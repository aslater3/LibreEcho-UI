#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-timerd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-timerd ] && . /etc/default/libreecho-timerd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-timerd}
PIDFILE=${PIDFILE:-/var/run/libreecho-timerd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-timerd.log}
SOCKET=${SOCKET:-/run/libreecho/timer.sock}
# A plain file, never a directory: an unrecognised directory under
# /data/libreecho/config fails the data contract and blocks every service on
# the next boot.
STATE=${STATE:-/data/libreecho/config/timers}
AUDIO_SOCKET=${AUDIO_SOCKET:-/run/libreecho/audio.sock}
ARGS=${ARGS:---foreground --socket $SOCKET --state $STATE --audio-socket $AUDIO_SOCKET}

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    if is_running; then echo "libreecho-timerd already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS \
            </dev/null >>"$LOGFILE" 2>&1
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if is_running && command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    elif is_running; then
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE" "$SOCKET"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
