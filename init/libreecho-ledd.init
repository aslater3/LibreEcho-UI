#!/bin/sh
### BEGIN INIT INFO
# Provides:          libreecho-ledd
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

[ -r /etc/default/libreecho-ledd ] && . /etc/default/libreecho-ledd

DAEMON=${DAEMON:-/usr/local/sbin/libreecho-ledd}
PIDFILE=${PIDFILE:-/var/run/libreecho-ledd.pid}
LOGFILE=${LOGFILE:-/var/log/libreecho-ledd.log}
SOCKET=${SOCKET:-/run/libreecho/led.sock}
STARTUP_READY=${STARTUP_READY:-/run/libreecho/startup-ready}
ARGS=${ARGS:---foreground --socket $SOCKET --startup-animation --startup-ready $STARTUP_READY}

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in *[!0-9]*|'') return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

start_service() {
    if is_running; then echo "libreecho-ledd already running"; return 0; fi
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")" "$(dirname "$SOCKET")"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS
    else
        "$DAEMON" $ARGS </dev/null >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
    fi
}

stop_service() {
    if ! is_running; then rm -f "$PIDFILE"; return 0; fi
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$PIDFILE" -R TERM/5/KILL/2
    else
        pid=$(sed -n '1p' "$PIDFILE")
        kill "$pid" 2>/dev/null || true
        count=0
        while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    status) if is_running; then echo "running"; else echo "stopped"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
