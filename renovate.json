{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/London",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prConcurrentLimit": 6,
  "prHourlyLimit": 2,
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Playwright version pinned directly by the browser E2E workflow",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/playwright-e2e\\.yml$/"
      ],
      "matchStrings": [
        "playwright@(?<currentValue>[0-9A-Za-z.+-]+)"
      ],
      "depNameTemplate": "playwright",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions maintenance",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
